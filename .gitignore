# 公众号本地凭据，禁止提交
wechat-config.json

# 本地素材与生成结果
images/
out/

# 本地私密数据
private/

# 知识库私密层：素材、选题库、已发存档与敏感词表（本地保留，不入库）
references/private/
references/sensitive/

# 本地备份归档（backup_private.sh 产物）
backups/

# Python 虚拟环境
.venv/
venv/
env/
ENV/

# Python 缓存与测试产物
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 其他可能包含敏感内容的本地文件
.env
*.log
*.key
*.pem

# 编辑过程中的备份文件（article.md.bak / meta.json.bak-* 等）
*.bak
*.bak-*
*.traineddata

# 浏览器自动化留下的临时目录
.edge-tmp*/
.tmp/

# WorkBuddy 本地项目数据（会话记忆等，不入库）
.workbuddy/